# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
# Public base URL of this API (used for links to uploaded images). Defaults to http://localhost:$PORT
PUBLIC_URL=
# Set to the number of reverse proxies in front of the API so req.ip and rate limits use the client IP
TRUST_PROXY=0
JSON_BODY_LIMIT=100kb
UPLOAD_DIR=uploads
# fatal|error|warn|info|debug|trace|silent (default: debug in development, info in production)
LOG_LEVEL=
MONGODB_URI=mongodb://localhost:27017/bookmyappointments

# JWT (use long random strings, e.g. `openssl rand -hex 32`; production requires 32+ characters, no placeholders, and two different values)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Field encryption for health data (appointment reason, consultation notes, prescriptions). REQUIRED in every environment.
# Entries are keyId:base64key (each key is 32 random bytes), comma-separated; generate one with `npm run generate-key`.
# Writes use DATA_ENCRYPTION_ACTIVE_KEY_ID; every listed key stays usable for reads, so keep old keys until
# `npm run encrypt-existing` has moved all data to the new one. Losing a key makes its data unreadable: back it up.
DATA_ENCRYPTION_KEYS=
DATA_ENCRYPTION_ACTIVE_KEY_ID=

# Admin account (password stored as a bcrypt hash: `npm run hash-password -- <password>`)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Comma-separated list of allowed browser origins (must be set explicitly when NODE_ENV=production)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# General per-IP request budget for /api (the health probe is exempt)
API_RATE_LIMIT_MAX=600
API_RATE_LIMIT_WINDOW_MINUTES=1

# Brute force protection: per-IP limit on /api/auth/* and per-account lockout after repeated wrong passwords
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15

# Clinic defaults (admin settings in the database override these)
CLINIC_TIMEZONE=Asia/Kathmandu
CURRENCY=INR
CANCELLATION_CUTOFF_HOURS=2
BOOKING_WINDOW_DAYS=14
DEFAULT_SLOT_MINUTES=30

# Links used in emails
APP_URL_PATIENT=http://localhost:5173
APP_URL_ADMIN=http://localhost:5174

# Optional: Google sign-in for patients
GOOGLE_CLIENT_ID=

# Optional: Cloudinary image storage (falls back to local ./uploads when empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: SMTP (emails are logged instead of sent when SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BookMyAppointments <no-reply@example.com>"

# Payments: "mock" (no external calls, development and test only) or "razorpay".
# NODE_ENV=production refuses to start in mock mode and requires all three Razorpay values.
PAYMENTS_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Background reminder job
REMINDERS_ENABLED=true
REMINDER_INTERVAL_MINUTES=10
REMINDER_LEAD_HOURS=24
