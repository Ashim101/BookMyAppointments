# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/bookmyappointments

# JWT (use long random strings, e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Admin account (password stored as a bcrypt hash: `npm run hash-password -- <password>`)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Clinic defaults (admin settings in the database override these)
CLINIC_TIMEZONE=Asia/Kathmandu
CURRENCY=INR
CANCELLATION_CUTOFF_HOURS=2
BOOKING_WINDOW_DAYS=14

# Links used in emails
APP_URL_PATIENT=http://localhost:5173
APP_URL_ADMIN=http://localhost:5174

# Optional: Google sign-in for patients
GOOGLE_CLIENT_ID=

# Optional: Cloudinary image storage (falls back to local ./uploads when empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: SMTP (emails are logged instead of sent when SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BookMyAppointments <no-reply@example.com>"

# Payments: "mock" (no external calls) or "razorpay"
PAYMENTS_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Background reminder job
REMINDER_INTERVAL_MINUTES=10
REMINDER_LEAD_HOURS=24
