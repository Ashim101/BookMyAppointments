# Copy to .env.local. Never commit real values.

# Base URL of the backend, without a trailing slash.
VITE_API_URL=http://localhost:4000

# Optional: public Google OAuth client id. Leave empty to hide Google sign-in.
VITE_GOOGLE_CLIENT_ID=

# Optional: cancellation cutoff in hours shown in the cancel dialog (keep equal to the backend setting).
VITE_CANCELLATION_CUTOFF_HOURS=24
