# Copy to .env (never commit it) and fill in the values marked REQUIRED.
# Used by docker-compose.yml. Backend-only settings live in Backend/.env.example.

# REQUIRED: two different random strings of 32+ characters, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# REQUIRED: the single administrator account. Generate the hash with
#   docker compose run --rm --no-deps backend node scripts/hash-password.js 'YourPassword1'
# and paste it inside SINGLE quotes so that Compose does not expand the $ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Host ports
API_PORT=4000
PATIENT_PORT=5173
STAFF_PORT=5174

# Public URLs as the browser sees them. The API URL is compiled into both apps at build time,
# so rebuild (docker compose build) after changing it.
PUBLIC_API_URL=http://localhost:4000
PUBLIC_PATIENT_URL=http://localhost:5173
PUBLIC_STAFF_URL=http://localhost:5174

# Clinic defaults
CLINIC_TIMEZONE=Asia/Kathmandu
CURRENCY=INR
TRUST_PROXY=0

# REQUIRED: payments. The production stack (docker-compose.yml) only runs with Razorpay and refuses mock mode.
# For a local trial with mock payments use docker-compose.demo.yml instead (see README).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email. Without SMTP_HOST, OTP and password-reset mails are discarded in production,
# so new patients cannot register; set it for a real deployment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BookMyAppointments <no-reply@example.com>"

# Optional Google sign-in for patients (public client id).
GOOGLE_CLIENT_ID=
